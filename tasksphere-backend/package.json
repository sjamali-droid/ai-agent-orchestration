{
  "name": "tasksphere-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TaskSphere Pro — backend microservices monorepo",
  "scripts": {
    "dev:auth": "ts-node-dev --respawn src/auth-service/index.ts",
    "dev:project": "ts-node-dev --respawn src/project-service/index.ts",
    "dev:task": "ts-node-dev --respawn src/task-service/index.ts",
    "dev:file": "ts-node-dev --respawn src/file-service/index.ts",
    "dev:notification": "ts-node-dev --respawn src/notification-service/index.ts",
    "build": "tsc",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "migrate:up": "ts-node scripts/migrate.ts up",
    "migrate:down": "ts-node scripts/migrate.ts down",
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.4.0",
    "dotenv": "^16.4.5",
    "kafkajs": "^2.2.4",
    "zod": "^3.23.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^10.0.0",
    "@types/nodemailer": "^6.4.16",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@types/jest": "^29.5.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}
