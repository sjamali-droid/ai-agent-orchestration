# Database
DATABASE_URL=postgresql://tasksphere:tasksphere@localhost:5432/tasksphere

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Kafka
KAFKA_BROKERS=localhost:9092

# S3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tasksphere-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@tasksphere.local

# Service ports
AUTH_SERVICE_PORT=3001
PROJECT_SERVICE_PORT=3002
TASK_SERVICE_PORT=3003
FILE_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
